{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": "src/server",
    "sourceMap": true
  },
  "include": ["src/server"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
